{
  "name": "mycelium",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3002",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3002",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:backup": "tsx scripts/backup.ts",
    "sync": "tsx scripts/sync.ts",
    "sql": "tsx scripts/sql.ts",
    "keygen": "tsx scripts/keygen.ts",
    "launchd:install": "tsx scripts/launchd.ts install",
    "launchd:uninstall": "tsx scripts/launchd.ts uninstall",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:resonant": "python3 -m unittest discover -s resonant-extension/tests",
    "sandbox:link": "tsx scripts/sandbox-link.ts",
    "demo": "DATABASE_PATH=data/demo.db tsx scripts/seed-demo.ts && DATABASE_PATH=data/demo.db next dev -H 127.0.0.1 -p 3002",
    "demo:seed": "DATABASE_PATH=data/demo.db tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.44.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "plaid": "^47.0.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-plaid-link": "^5.0.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
