# Copy to .env.local (or run `npm run keygen`, which creates it for you).

# Plaid keys from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (fake data, free) or production (real accounts)
PLAID_ENV=sandbox

# 64 hex chars; encrypts Plaid access tokens at rest. `npm run keygen` makes one.
MYCELIUM_ENC_KEY=

# Optional: where the SQLite file lives (default ./data/mycelium.db)
# DATABASE_PATH=./data/mycelium.db
