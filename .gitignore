# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- mycelium ---
# Local database + backups: personal data, never committed.
/data
/backups
.env.local
.claude/settings.local.json

# Keep the template (no secrets in it)
!.env.example
# Local sync log written by the launchd job
*.log
# Any SQLite file outside data/ (scratch copies, backups)
*.db
*.db-shm
*.db-wal
*.sqlite
